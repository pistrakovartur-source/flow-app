{
  "name": "flow-planner",
  "version": "1.0.1",
  "description": "Flow — персональный планировщик",
  "main": "main.js",
  "scripts": {
    "build": "chcp 65001 >nul && node build.mjs",
    "start": "chcp 65001 >nul && node build.mjs && electron .",
    "dev": "chcp 65001 >nul && electron . --dev",
    "dist": "chcp 65001 >nul && node build.mjs && electron-builder --win",
    "release": "chcp 65001 >nul && node build.mjs && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "https-proxy-agent": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.21.5"
  },
  "build": {
    "appId": "com.flow.planner",
    "productName": "Flow",
    "copyright": "© 2025 Flow",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!src/**/*",
      "!bot-server/**/*",
      "!build.mjs",
      "!CONTEXT.md",
      "!release/**/*"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flow",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049"
    },
    "publish": {
      "provider": "github",
      "owner": "pistrakovartur-source",
      "repo": "flow-app"
    }
  }
}
